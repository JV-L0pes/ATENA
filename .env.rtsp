# Configuração para RTSP via Tailscale
# =====================================

# Tipo de vídeo: usb (webcam local) ou rtsp (stream remoto)
VIDEO_TYPE=rtsp

# URL do stream RTSP via Tailscale
# Substitua pelo IP Tailscale do seu PC local
RTSP_URL=rtsp://100.116.238.18:8554/cam1

# Configurações do modelo
MODEL_PATH=athena_training_2phase_optimized/models/phase1_complete/athena_phase1_tesla_t4/weights/best.pt
MODEL_CONF_THRESH=0.25

# Configurações da API
API_HOST=0.0.0.0
API_PORT=3000

# Configurações de vídeo
VIDEO_FPS=30
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_SOURCE=rtsp://100.116.238.18:8554/cam1

# Logging
LOG_LEVEL=INFO
